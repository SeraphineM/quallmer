  # Method 2: Manual conversion (old way)
  docvars <- attr(data_corpus_manifsentsUK2010sample, "docvars")
  internal_vars <- c("docname_", "docid_", "segid_")
  user_vars <- setdiff(names(docvars), internal_vars)

