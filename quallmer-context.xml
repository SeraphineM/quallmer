	cd gh-pages-tmp && \
		git add articles/ && \
		git commit -m "Update articles" && \
		git push origin HEAD:gh-pages
	git worktree remove gh-pages-tmp

# Full local site build (with updated README)
site: readme
	Rscript -e "pkgdown::build_site()"
